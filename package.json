{
  "name": "@linked365/pptb-environment-manager",
  "version": "1.1.0",
  "displayName": "Environment Manager",
  "description": "A Power Platform Tool Box tool to manage optional settings per environment.",
  "main": "index.html",
  "icon": "envManagerLogo.svg",
  "contributors": [
    {
      "name": "LinkeD365",
      "url": "https://linked365.blog"
    },
    {
      "name": "MscrmTools"
    }
  ],
  "keywords": [
    "powerplatform",
    "dataverse",
    "toolbox"
  ],
  "features": {
    "connections": {
      "min": 1,
      "max": 5
    },
    "enabledForPowerPlatformAPI": true,
    "minAPI": "1.2.7"
  },
  "configurations": {
    "repository": "https://github.com/LinkeD365/PPTB-EnvManager",
    "website": "https://linked365.blog",
    "readmeUrl": "https://raw.githubusercontent.com/LinkeD365/PPTB-EnvManager/refs/heads/main/README.md"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LinkeD365/PPTB-EnvManager"
  },
  "bugs": {
    "url": "https://github.com/LinkeD365/PPTB-EnvManager/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "cspExceptions": {
    "connect-src": [
      {
        "domain": "https://raw.githubusercontent.com/seanmcne/OrgDbOrgSettings/master/mspfedyn_/OrgDbOrgSettings/Solution/WebResources/mspfedyn_/OrgDbOrgSettings/Settings.xml",
        "exceptionReason": "Load organization setting definitions and descriptions"
      },
      {
        "domain": "https://raw.githubusercontent.com/LinkeD365/OrgSettings/master/LinkeD65OrgSettings.xml",
        "exceptionReason": "Optional additional organization setting guidance",
        "optional": true
      }
    ]
  },
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "finalize-package": "npm shrinkwrap",
    "validate": "pptb-validate",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --test tests/writeConfirmation.test.mjs",
    "test:components": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.72.9",
    "@fluentui/react-icons": "^2.0.316",
    "ag-grid-community": "^35.0.0",
    "ag-grid-react": "^35.0.0",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "write-excel-file": "^2.3.10"
  },
  "devDependencies": {
    "@pptb/types": "^1.2.7",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "IMPLEMENTATION.md"
  ]
}
